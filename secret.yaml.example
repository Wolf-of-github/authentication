apiVersion: v1
kind: Secret
metadata:
  name: authentication-secrets
  namespace: default
type: Opaque
stringData:
  JWT_SECRET: "replace-with-32-plus-random-bytes"
  MONGODB_URI: "mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority"
  MONGODB_DB_NAME: "authentication"
  ADMIN_EMAIL: "admin@example.com"
  ADMIN_PASSWORD: "change-this-password"
  ADMIN_NAME: "Admin"
